@import "../backup/index.wxss";
.settings {
  padding-bottom: calc(80px + env(safe-area-inset-bottom));
}
.privacy {
  margin: 16px;
  padding-top: 16px;
  border-top: 1px solid #e3e5dc;
}
.label {
  font-size: 14px;
  font-weight: 600;
  color: #365b43;
}
.body {
  font-size: 14px;
  margin: 12px 0;
}
.more {
  font-weight: 500;
  color: #365b43;
  border: 1px solid #8c9683;
  border-radius: 24px;
  background: transparent;
  font-size: 14px;
}
.more::after {
  border: 0;
}
.version {
  border-top: 1px solid #e3e5dc;
  padding-top: 18px;
  margin: 18px 0;
  color: #737d71;
  font-size: 12px;
}
.settings button:not([size="mini"]) {
  width: 100%;
}
