page {
  background: #f6f5f0;
  color: #28392f;
}

button[class]:not([size="mini"]) {
  width: auto;
  min-width: 0;
  max-width: none;
  height: auto;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  text-align: inherit;
  font-size: inherit;
  font-weight: 400;
  line-height: normal;
}

button::after { border: 0; }
button[class]:not([size="mini"])[disabled] { background: transparent; color: #a0a89c; }

.record-page { min-height: 100%; }
.row { display: flex; align-items: center; }

.brand {
  position: fixed;
  z-index: 3;
  top: 0;
  right: 0;
  left: 0;
  background: #f6f5f0;
}

.record-body { padding: 36rpx 48rpx 48rpx; }
.title { flex: 1; font-size: 56rpx; font-weight: 500; }
button.text-button:not([size="mini"]) {
  display: flex;
  min-height: 84rpx;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  color: #365b43;
  font-size: 24rpx;
  font-weight: 500;
}

.record-heading > button.text-button:not([size="mini"]) { padding-right: 0; }
.date-row { margin-top: 10rpx; margin-bottom: 24rpx; gap: 6rpx; white-space: nowrap; }
button.date-control:not([size="mini"]) {
  flex: 1;
  justify-content: flex-start;
  gap: 12rpx;
  min-height: 96rpx;
  padding: 0;
  color: #677264;
}

.calendar-icon {
  position: relative;
  width: 26rpx;
  height: 23rpx;
  border: 2rpx solid currentColor;
  border-radius: 3rpx;
}

.calendar-icon::before {
  position: absolute;
  top: 4rpx;
  left: 0;
  width: 100%;
  border-top: 2rpx solid currentColor;
  content: '';
}

.count { color: #365b43; font-size: 24rpx; }
button.icon-button:not([size="mini"]) {
  display: flex;
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 96rpx;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 1;
}

.menu-anchor { position: relative; flex: 0 0 auto; }
.menu-scrim { position: fixed; z-index: 5; top: 0; right: 0; bottom: 0; left: 0; }
.dropdown {
  position: absolute;
  z-index: 6;
  top: 78rpx;
  right: 0;
  min-width: 215rpx;
  padding: 12rpx 0;
  border-radius: 10rpx;
  background: #e9eddf;
  box-shadow: 0 8rpx 26rpx rgba(30, 42, 32, .17);
}

.dropdown button:not([size="mini"]) { display: block; width: 100%; min-height: 96rpx; padding: 12rpx 28rpx; font-size: 29rpx; white-space: nowrap; }
.record-banner { min-height: 86rpx; justify-content: space-between; margin-bottom: 24rpx; padding: 0 8rpx 0 24rpx; border-radius: 28rpx; background: #e9eddf; font-size: 24rpx; }
.error-banner { justify-content: space-between; padding-left: 16rpx; color: #ba1a1a; font-size: 28rpx; }
.pager { justify-content: space-between; color: #677264; font-size: 24rpx; }
.exercise-card { padding: 32rpx; border: 1px solid #e3e5dc; border-radius: 42rpx; background: #fbfcf7; }
.pager-window { touch-action: pan-y; }
.pager-window-active { overflow: hidden; }
.pager-track { position: relative; }
.pager-settling { transition: transform 180ms cubic-bezier(.2, .75, .25, 1); }
.pager-neighbor { position: absolute; top: 0; width: 100%; pointer-events: none; }
.pager-before { right: calc(100% + 32rpx); }
.pager-after { left: calc(100% + 32rpx); }

@media (prefers-reduced-motion: reduce) {
  .pager-settling { transition: none; }
}

button.exercise-title:not([size="mini"]) { min-height: 86rpx; min-width: 0; flex: 1; padding: 12rpx 12rpx 12rpx 0; font-size: 34rpx; font-weight: 500; overflow-wrap: anywhere; }
.mode-tag { padding: 10rpx 18rpx; border-radius: 14rpx; background: #e9eddf; color: #647266; font-size: 22rpx; white-space: nowrap; }
.set-row,
button.set-row:not([size="mini"]) {
  display: grid;
  width: 100%;
  grid-template-columns: 14% minmax(0, 1fr) minmax(0, 1fr) 36rpx;
  align-items: center;
  gap: 6rpx;
  padding: 14rpx 0;
  color: #677264;
  font-size: 22rpx;
}
button.logged-set:not([size="mini"]) { min-height: 88rpx; border-top: 1px solid #e3e5dc; }
.logged-set text:nth-child(3) { color: #28392f; font-size: 26rpx; }
.logged-set .check { color: #365b43; font-size: 31rpx; text-align: right; }
.set-row + .draft { margin-top: 24rpx; }
.draft { padding: 28rpx; border-radius: 34rpx; background: #eef1e6; }
.draft-header { min-height: 48rpx; justify-content: space-between; gap: 12rpx; font-size: 28rpx; font-weight: 500; }
.draft-header .muted { color: #677264; font-size: 22rpx; font-weight: 400; }
.metric-heading { min-height: 48rpx; justify-content: space-between; margin-top: 10rpx; color: #677264; font-size: 24rpx; font-weight: 500; }
button.step-menu-button:not([size="mini"]) {
  display: flex;
  min-height: 62rpx;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
  border: 1px solid #8c9683;
  border-radius: 18rpx;
  color: #365b43;
  font-size: 22rpx;
  white-space: nowrap;
}
.metric-heading .dropdown { top: 62rpx; }
.stepper { min-height: 98rpx; margin-top: 6rpx; }
button.step-button:not([size="mini"]) {
  display: flex;
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 96rpx;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #fbfcf7;
  color: #365b43;
  text-align: center;
  font-size: 50rpx;
  line-height: 1;
}
button.step-button:not([size="mini"])[disabled] { background: #e3e5dc; }
.measurement { display: flex; min-width: 0; flex: 1; align-items: baseline; justify-content: center; gap: 6rpx; font-size: 56rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.unit { color: #677264; font-size: 24rpx; font-weight: 400; }
.metric-slider { margin: 8rpx 8rpx 0; }
.slider-labels { justify-content: space-between; color: #677264; font-size: 22rpx; }
.rule { height: 1px; margin: 18rpx 0 12rpx; background: #e3e5dc; }
button.complete-button:not([size="mini"]) {
  display: flex;
  width: 100%;
  min-height: 100rpx;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 25rpx;
  border-radius: 26rpx;
  background: #365b43;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}
button.complete-button:not([size="mini"])[disabled] { background: #dfe5d9; color: #677264; }
button.add-exercise:not([size="mini"]) {
  display: flex;
  width: 100%;
  min-height: 108rpx;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 24rpx;
  border: 1px solid #e3e5dc;
  border-radius: 36rpx;
  color: #365b43;
  font-size: 28rpx;
  font-weight: 500;
}
.add-exercise > text:first-child { font-size: 40rpx; }
button.empty-history:not([size="mini"]) { width: 100%; margin-top: 10rpx; }
.snackbar { position: fixed; z-index: 9; right: 32rpx; bottom: calc(120rpx + env(safe-area-inset-bottom)); left: 32rpx; min-height: 96rpx; justify-content: space-between; gap: 10rpx; padding: 0 24rpx; border-radius: 8rpx; background: #2c322e; color: #edf2ec; font-size: 28rpx; }
.snackbar button.text-button:not([size="mini"]) { flex: 0 0 auto; color: #96d5b3; }

.overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; display: flex; }
.sheet-layer { z-index: 12; flex-direction: column; justify-content: flex-end; }
.dialog-layer { z-index: 14; align-items: center; justify-content: center; }
.scrim { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(0, 0, 0, .33); }
.sheet {
  position: relative;
  padding: 12rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 56rpx 56rpx 0 0;
  background: #f1f2ea;
}
.sheet-handle { width: 64rpx; height: 8rpx; margin: 16rpx auto 18rpx; border-radius: 999rpx; background: #acb4a7; }
.sheet-heading { min-height: 72rpx; justify-content: space-between; font-size: 44rpx; }
.search-icon { position: relative; width: 27rpx; height: 27rpx; margin-bottom: 5rpx; border: 3rpx solid #28392f; border-radius: 50%; }
.search-icon::after { position: absolute; right: -11rpx; bottom: -5rpx; width: 15rpx; height: 3rpx; transform: rotate(46deg); background: #28392f; content: ''; }
.sheet-scroll { max-height: 54vh; margin-top: 12rpx; }
.picker-label { padding: 24rpx 8rpx 8rpx; color: #365b43; font-size: 28rpx; font-weight: 500; }
.picker-row { min-height: 112rpx; gap: 4rpx; }
button.picker-item:not([size="mini"]) { min-width: 0; min-height: 112rpx; flex: 1; padding: 15rpx 8rpx; }
.picker-item text { display: block; }
.picker-item text:first-child, .preset-row text:first-child { font-size: 32rpx; overflow-wrap: anywhere; }
.picker-item text:last-child, .preset-row text:last-child { color: #677264; font-size: 24rpx; }
button.preset-row:not([size="mini"]) { width: 100%; min-height: 128rpx; justify-content: space-between; gap: 12rpx; padding: 12rpx 8rpx; }
.preset-row text:last-child { flex: 0 0 auto; }
button.custom-exercise:not([size="mini"]) { padding-left: 16rpx; font-size: 28rpx; }
.history-hint { padding-top: 8rpx; color: #677264; font-size: 24rpx; }
.exercise-session { padding: 16rpx 0; border-bottom: 1px solid #e3e5dc; font-size: 28rpx; line-height: 1.5; }
.session-date { font-size: 28rpx; font-weight: 500; }
.session-date text { color: #365b43; }

.dialog {
  position: relative;
  width: calc(100% - 96rpx);
  max-width: 660rpx;
  max-height: 92vh;
  overflow-y: auto;
  padding: 48rpx 48rpx 24rpx;
  border-radius: 56rpx;
  background: #e9eddf;
}
.dialog-title { margin-bottom: 30rpx; font-size: 48rpx; overflow-wrap: anywhere; }
.dialog-actions { justify-content: flex-end; flex-wrap: wrap; margin-top: 22rpx; }
.edit-actions button.destructive:not([size="mini"]) { margin-right: auto; color: #ba1a1a; }
.edit-inputs { gap: 16rpx; }
.edit-field { min-width: 0; flex: 1; color: #677264; font-size: 24rpx; }
.edit-field text { display: block; margin-bottom: 7rpx; }
.outlined-input { width: 100%; height: 102rpx; padding: 0 24rpx; border: 1px solid #8c9683; border-radius: 8rpx; color: #28392f; font-size: 32rpx; }
.radio-row { min-height: 93rpx; gap: 14rpx; font-size: 28rpx; }
.radio-row:first-child { margin-top: 6rpx; }
.radio-row radio { flex: 0 0 auto; transform: scale(.8); }
.form-error { margin: 10rpx 0; color: #ba1a1a; font-size: 26rpx; overflow-wrap: anywhere; }
.date-dialog { width: calc(100% - 48rpx); max-width: 740rpx; padding: 32rpx 24rpx 18rpx; }
.date-dialog-caption { padding: 0 24rpx; color: #677264; font-size: 26rpx; }
.date-dialog-header { justify-content: space-between; min-height: 105rpx; padding: 0 0 0 24rpx; border-bottom: 1px solid #d4dbcf; font-size: 47rpx; }
.calendar-heading { padding: 4rpx 0; gap: 4rpx; }
button.calendar-month:not([size="mini"]) { justify-content: flex-start; flex: 1; font-size: 27rpx; }
.calendar-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); text-align: center; }
.calendar-grid > text { min-height: 68rpx; padding-top: 12rpx; color: #677264; font-size: 23rpx; }
.calendar-cell { display: flex; min-height: 76rpx; align-items: center; justify-content: center; }
.calendar-cell button:not([size="mini"]) { display: flex; width: 73rpx; height: 73rpx; align-items: center; justify-content: center; border-radius: 50%; font-size: 27rpx; }
.calendar-cell button.calendar-selected:not([size="mini"]) { background: #365b43; color: #fff; }
.calendar-cell button.calendar-today:not([size="mini"]) { border: 1px solid #365b43; color: #365b43; }
.calendar-year-scroll { height: 407rpx; }
.calendar-years { display: grid; grid-template-columns: repeat(3, 1fr); }
.calendar-years button:not([size="mini"]) { height: 80rpx; text-align: center; font-size: 27rpx; }
.date-input { width: calc(100% - 48rpx); margin: 30rpx auto 0; }
.calendar-error { padding: 0 24rpx; }
