.hint {
  background: #e9eddf;
  color: #28392f;
  border-radius: 12px;
  padding: 12px 16px 4px;
  font-size: 14px;
  line-height: 1.5;
}
.title {
  display: block;
  font-weight: 600;
}
button {
  margin: 0 0 0 auto;
  width: max-content;
  font-size: 12px;
  color: #365b43;
  background: none;
}
button::after {
  border: 0;
}
